#!/usr/bin/env bash
# Pre-commit gate:
#   (1) leak scan — block commits containing private terms (see leak-scan.sh).
#   (2) ruff — auto-fix what it can (format + safe --fix), RE-STAGE those fixes
#       into the commit, then block only on issues ruff can't fix. This is what
#       CI enforces, so a lint error can't slip into a push (it has, twice).
# Runs ruff in a throwaway container (no ruff installed locally). Bypass lint
# with LINT_SKIP=1; skips with a warning if no
# container runtime. --force-exclude keeps the generated *_pb2.py untouched (CI
# requires it byte-identical to protoc output).
set -uo pipefail
root="$(git rev-parse --show-toplevel)"

# (1) Leak scan.
"$root/.githooks/leak-scan.sh" || exit 1

# (2) Lint auto-fix + verify.
[ "${LINT_SKIP:-}" = "1" ] && exit 0
mapfile -t staged_py < <(git diff --cached --name-only --diff-filter=ACM -- '*.py')
[ "${#staged_py[@]}" -eq 0 ] && exit 0   # nothing Python staged

runner=""
if command -v podman >/dev/null 2>&1; then
    runner=podman
elif command -v docker >/dev/null 2>&1; then
    runner=docker
fi
if [ -z "$runner" ]; then
    echo "pre-commit: no podman/docker — skipping ruff (GitHub CI still checks)." >&2
    exit 0
fi

img=docker.io/library/python:3.13-slim
dirs="custom_components tests tests_ha"

# Auto-fix in place, then verify — all in one container run (fixes land in the
# working tree; the trailing format-check + check is the verification).
out="$("$runner" run --rm -v "$root":/app:z -w /app "$img" bash -lc "
    pip install -q ruff >/dev/null 2>&1
    ruff format --no-cache --force-exclude $dirs >/dev/null 2>&1
    ruff check --fix --no-cache --force-exclude $dirs >/dev/null 2>&1
    ruff format --check --no-cache --force-exclude $dirs && ruff check --no-cache --force-exclude $dirs
" 2>&1)"
status=$?

# Re-stage the originally-staged .py files the fixers rewrote.
restaged=0
for f in "${staged_py[@]}"; do
    if ! git diff --quiet -- "$f" 2>/dev/null; then
        git add -- "$f"
        restaged=1
    fi
done
[ "$restaged" = 1 ] && echo "pre-commit: ruff auto-fixed + re-staged file(s)." >&2

if [ "$status" -ne 0 ]; then
    echo "$out" | grep -vE "WARNING: Running pip|pip install|notice|already satisfied" >&2
    echo "" >&2
    echo "pre-commit: BLOCKED — ruff issues remain that it can't auto-fix. Fix them, or 'LINT_SKIP=1 git commit' to override." >&2
    exit 1
fi
exit 0
